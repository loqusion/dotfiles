{
  "ns": {
    "prefix": "ns",
    "body": ["namespace ${1:MyNamespace} {", "\t$0", "} // namespace $1"]
  },
  "namespace": {
    "prefix": "namespace",
    "body": ["namespace ${1:MyNamespace} {", "\t$0", "} // namespace $1"]
  },
  "#guard": {
    "prefix": "#guard",
    "body": [
      "#ifndef ${TM_DIRECTORY/.*[\\/\\\\](.*)/${1:/upcase}/}${TM_FILENAME_BASE/(.*)/_${1:/upcase}/}${TM_FILENAME/.*\\.(.*)/_${1:/upcase}/}_",
      "#define ${TM_DIRECTORY/.*[\\/\\\\](.*)/${1:/upcase}/}${TM_FILENAME_BASE/(.*)/_${1:/upcase}/}${TM_FILENAME/.*\\.(.*)/_${1:/upcase}/}_",
      "",
      "$0",
      "",
      "#endif  // ${TM_DIRECTORY/.*[\\/\\\\](.*)/${1:/upcase}/}${TM_FILENAME_BASE/(.*)/_${1:/upcase}/}${TM_FILENAME/.*\\.(.*)/_${1:/upcase}/}_"
    ],
    "description": "header guard. format :\n\tINCLUDE_<dirname>_<filename>_<extension>_"
  }
}
